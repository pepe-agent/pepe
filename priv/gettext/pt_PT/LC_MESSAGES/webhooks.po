#: lib/pepe/webhooks/media.ex:418
#, elixir-autogen, elixir-format
msgid "I can't pick up attachments on this channel yet. Could you send it as text?"
msgstr "Ainda não consigo receber anexos neste canal. Podes enviar em texto?"

#: lib/pepe/webhooks/media.ex:420
#, elixir-autogen, elixir-format
msgid "I couldn't download that file. Could you send it again?"
msgstr "Não consegui transferir esse ficheiro. Podes enviá-lo outra vez?"

#: lib/pepe/webhooks/media.ex:265
#, elixir-autogen, elixir-format
msgid "I couldn't make out any speech in that."
msgstr "Não consegui perceber nenhuma fala nisto."

#: lib/pepe/webhooks.ex:250
#, elixir-autogen, elixir-format
msgid "I'm a bit behind on messages here. Could you send that again in a moment?"
msgstr ""
"Estou com mensagens atrasadas aqui. Podes enviar outra vez daqui a pouco?"

#: lib/pepe/webhooks/discord.ex:117
#: lib/pepe/webhooks/whatsapp.ex:71
#, elixir-autogen, elixir-format
msgid "Largest attachment (MB)"
msgstr "Anexo máximo (MB)"

#: lib/pepe/webhooks/media.ex:412
#, elixir-autogen, elixir-format
msgid "That file is too big for me to take in here. Could you send a smaller version, or share it another way?"
msgstr ""
"Esse ficheiro é demasiado grande para o receber aqui. Podes enviar uma "
"versão mais pequena ou partilhá-lo de outra forma?"

#: lib/pepe/webhooks.ex:363
#, elixir-autogen, elixir-format
msgid "(unset)"
msgstr "(não definido)"

#: lib/pepe/webhooks.ex:676
#, elixir-autogen, elixir-format
msgid "Available models:"
msgstr "Modelos disponíveis:"

#: lib/pepe/webhooks.ex:697
#, elixir-autogen, elixir-format
msgid "Change %{name} for this conversation only, or for everyone? Reply /model %{name} session or /model %{name} global."
msgstr ""
"Mudar para %{name} só nesta conversa ou para todos? Responde /model %{name} "
"session ou /model %{name} global."

#: lib/pepe/webhooks.ex:364
#, elixir-autogen, elixir-format
msgid "Current model: %{model}"
msgstr "Modelo atual: %{model}"

#: lib/pepe/webhooks.ex:661
#, elixir-autogen, elixir-format
msgid "Mention requirement is currently: off (I reply without being mentioned).\nUse /mention on or /mention off."
msgstr ""
"Menção obrigatória: desligada (respondo sem ser mencionado).\n"
"Usa /mention on ou /mention off."

#: lib/pepe/webhooks.ex:671
#, elixir-autogen, elixir-format
msgid "Mention requirement is currently: on (I need an @mention).\nUse /mention on or /mention off."
msgstr ""
"Menção obrigatória: ligada (só respondo se me @mencionarem).\n"
"Usa /mention on ou /mention off."

#: lib/pepe/webhooks.ex:708
#, elixir-autogen, elixir-format
msgid "Model set to %{name} (%{scope})."
msgstr "Modelo definido: %{name} (%{scope})."

#: lib/pepe/webhooks.ex:710
#, elixir-autogen, elixir-format
msgid "No agent to set the model on."
msgstr "Não há nenhum agente onde definir o modelo."

#: lib/pepe/webhooks.ex:673
#, elixir-autogen, elixir-format
msgid "No models are configured for this project."
msgstr "Este projeto não tem modelos configurados."

#: lib/pepe/webhooks.ex:652
#, elixir-autogen, elixir-format
msgid "Noted, but this connection already answers every message here without needing a mention (require_mention is off on the connection) - this channel keeps replying without one regardless."
msgstr ""
"Anotado, mas esta ligação já responde a todas as mensagens sem menção "
"(require_mention está desligado na ligação). Este canal continua a responder"
" sem menção."

#: lib/pepe/webhooks.ex:664
#, elixir-autogen, elixir-format
msgid "This channel's own setting asks for a mention, but the connection itself already answers every message without one (require_mention is off) - so nothing here actually needs a mention right now."
msgstr ""
"A definição deste canal pede menção, mas a ligação já responde a todas as "
"mensagens sem ela (require_mention está desligado). Por isso, neste momento "
"nada aqui exige menção."

#: lib/pepe/webhooks.ex:679
#, elixir-autogen, elixir-format
msgid "Unknown model: %{name}"
msgstr "Modelo desconhecido: %{name}"

#: lib/pepe/webhooks.ex:609
#, elixir-autogen, elixir-format
msgid "Usage: /mention on|off"
msgstr "Utilização: /mention on|off"

#: lib/pepe/webhooks.ex:678
#, elixir-autogen, elixir-format
msgid "Usage: /model NAME [session|global]"
msgstr "Utilização: /model NOME [session|global]"

#: lib/pepe/webhooks.ex:688
#, elixir-autogen, elixir-format
msgid "You don't have permission to change the model here."
msgstr "Não tens permissão para mudar o modelo aqui."

#: lib/pepe/webhooks.ex:645
#, elixir-autogen, elixir-format
msgid "👂 I'll reply here without being @mentioned, until /new."
msgstr "👂 Vou responder aqui sem precisar de @menção, até ao /new."

#: lib/pepe/webhooks.ex:658
#, elixir-autogen, elixir-format
msgid "📣 @mention required again in this chat."
msgstr "📣 Esta conversa volta a exigir @menção."

#: lib/pepe/webhooks.ex:577
#, elixir-autogen, elixir-format
msgid "🧹 New conversation."
msgstr "🧹 Nova conversa."

#: lib/pepe/webhooks.ex:461
#, elixir-autogen, elixir-format
msgid "This channel is bound to agent %{name}.\nUse /agent NAME to change it, or /agent none to clear."
msgstr ""
"Este canal tem o agente %{name} fixo.\n"
"Usa /agent NOME para o mudar, ou /agent none para o remover."

#: lib/pepe/webhooks.ex:403
#, elixir-autogen, elixir-format
msgid "This channel is no longer bound to a specific agent - back to %{agent}."
msgstr "Este canal já não tem um agente fixo. Voltou para %{agent}."

#: lib/pepe/webhooks.ex:446
#, elixir-autogen, elixir-format
msgid "This channel is now bound to agent %{name} (kept across /new and restarts)."
msgstr ""
"Este canal fica agora com o agente %{name} (mantém-se após /new e "
"reinícios)."

#: lib/pepe/webhooks.ex:454
#, elixir-autogen, elixir-format
msgid "This channel isn't bound to a specific agent - it uses %{agent} (this connection's default).\nUse /agent NAME to bind it."
msgstr ""
"Este canal não tem um agente fixo: usa %{agent} (o da predefinição desta ligação).\n"
"Usa /agent NOME para o fixar."

#: lib/pepe/webhooks.ex:474
#, elixir-autogen, elixir-format
msgid "Unknown agent: %{name}"
msgstr "Agente desconhecido: %{name}"

#: lib/pepe/webhooks.ex:396
#, elixir-autogen, elixir-format
msgid "You don't have permission to change this channel's agent."
msgstr "Não tens permissão para mudar o agente deste canal."

#: lib/pepe/webhooks.ex:484
#, elixir-autogen, elixir-format
msgid "Agent switching is locked on this channel."
msgstr "Neste canal não se pode mudar de agente."

#: lib/pepe/webhooks.ex:472
#, elixir-autogen, elixir-format
msgid "This channel is bound to agent %{name}. Agent switching is locked here."
msgstr ""
"Este canal tem o agente %{name} fixo. Aqui não se pode mudar de agente."

#: lib/pepe/webhooks.ex:465
#, elixir-autogen, elixir-format
msgid "This channel isn't bound to a specific agent - it uses %{agent} (this connection's default). Agent switching is locked here."
msgstr ""
"Este canal não tem um agente fixo: usa %{agent} (o da predefinição desta "
"ligação). Aqui não se pode mudar de agente."

#: lib/pepe/webhooks/discord.ex:88
#, elixir-autogen, elixir-format
msgid "Also answer normal messages, not only slash commands. Needs the bot token."
msgstr ""
"Responde também a mensagens normais, não só a comandos slash. Precisa do "
"token do bot."

#: lib/pepe/webhooks/msteams.ex:50
#, elixir-autogen, elixir-format
