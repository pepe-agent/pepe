msgstr "Maior ficheiro que aceita, em MB (predefinição: 20)."

#: lib/pepe/webhooks/slack.ex:47
#, elixir-autogen, elixir-format
msgid "Find it on the app's Basic Information page. Write it as ${ENV_VAR}."
msgstr ""
"Encontra-o na página Basic Information da app. Escreve-o como ${ENV_VAR}."

#: lib/pepe/webhooks/discord.ex:99
#, elixir-autogen, elixir-format
msgid "Find it on the app's Bot page. Needed to read channel messages."
msgstr ""
"Encontra-o na página Bot da app. Necessário para ler mensagens dos canais."

#: lib/pepe/webhooks/slack.ex:65
#, elixir-autogen, elixir-format
msgid "In channels, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"Nos canais, responde só quando alguém menciona o bot com @ (predefinição: "
"sim)."

#: lib/pepe/webhooks/googlechat.ex:59
#, elixir-autogen, elixir-format
msgid "In group spaces, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"Nos espaços de grupo, responde só quando alguém menciona o bot com @ "
"(predefinição: sim)."

#: lib/pepe/webhooks/discord.ex:110
#, elixir-autogen, elixir-format
msgid "In server channels, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"Nos canais do servidor, responde só quando alguém menciona o bot com @ "
"(predefinição: sim)."

#: lib/pepe/webhooks/msteams.ex:58
#, elixir-autogen, elixir-format
msgid "In team channels, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"Nos canais da equipa, responde só quando alguém menciona o bot com @ "
"(predefinição: sim)."

#: lib/pepe/webhooks/whatsapp.ex:55
#, elixir-autogen, elixir-format
