#: lib/pepe_web/live/tool_servers_live.ex:218
#, elixir-autogen, elixir-format
msgid "Auto picks the right protocol. Pin one only if the server supports just that one."
msgstr ""
"Auto elige el protocolo correcto. Fija uno solo si el servidor admite "
"únicamente ese."

#: lib/pepe_web/live/agents_live.ex:348
#, elixir-autogen, elixir-format
msgid "Backup models, tried in order if this one fails. Usually you can skip it."
msgstr ""
"Modelos de respaldo, probados en orden si este falla. Normalmente puedes "
"dejarlo vacío."

#: lib/pepe_web/live/integrations_live.ex:55
#, elixir-autogen, elixir-format
msgid "Built-in channels (WhatsApp, Slack, Discord, Teams, Google Chat) are under Channels."
msgstr ""
"Los canales incluidos (WhatsApp, Slack, Discord, Teams, Google Chat) están "
