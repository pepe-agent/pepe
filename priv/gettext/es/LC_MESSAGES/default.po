msgstr ""
"El mensaje de sistema exacto que se envía en cada conversación. La "
"personalidad es solo el comienzo."

#: lib/pepe_web/live/tokens_live.ex:116
#, elixir-autogen, elixir-format
msgid "The site's address, like https://example.com. Needs an agent above."
msgstr ""
"La dirección del sitio, como https://example.com. Requiere un agente arriba."

#: lib/pepe_web/live/channels_live.ex:330
#, elixir-autogen, elixir-format
msgid "The site's address, like https://example.com. Other origins are refused."
msgstr ""
"La dirección del sitio, como https://example.com. Se rechazan otros "
"orígenes."

#: lib/pepe_web/live/hooks_live.ex:275
#, elixir-autogen, elixir-format
