#: lib/pepe/webhooks/media.ex:418
#, elixir-autogen, elixir-format
msgid "I can't pick up attachments on this channel yet. Could you send it as text?"
msgstr ""
"Todavía no puedo recibir adjuntos por este canal. ¿Puedes enviarlo como "
"texto?"

#: lib/pepe/webhooks/media.ex:420
#, elixir-autogen, elixir-format
msgid "I couldn't download that file. Could you send it again?"
msgstr "No pude descargar ese archivo. ¿Puedes enviarlo otra vez?"

#: lib/pepe/webhooks/media.ex:265
#, elixir-autogen, elixir-format
msgid "I couldn't make out any speech in that."
msgstr "No pude distinguir ninguna voz en eso."

#: lib/pepe/webhooks.ex:250
#, elixir-autogen, elixir-format
msgid "I'm a bit behind on messages here. Could you send that again in a moment?"
msgstr ""
"Voy un poco atrasado con los mensajes. ¿Puedes enviarlo de nuevo en un "
"momento?"

#: lib/pepe/webhooks/discord.ex:117
#: lib/pepe/webhooks/whatsapp.ex:71
#, elixir-autogen, elixir-format
msgid "Largest attachment (MB)"
msgstr "Adjunto máximo (MB)"

#: lib/pepe/webhooks/media.ex:412
#, elixir-autogen, elixir-format
msgid "That file is too big for me to take in here. Could you send a smaller version, or share it another way?"
msgstr ""
"Ese archivo es demasiado grande para recibirlo aquí. ¿Puedes enviar una "
"versión más pequeña o compartirlo de otra forma?"

#: lib/pepe/webhooks.ex:353
#, elixir-autogen, elixir-format
msgid "(unset)"
msgstr "(sin definir)"

#: lib/pepe/webhooks.ex:660
#, elixir-autogen, elixir-format
msgid "Available models:"
msgstr "Modelos disponibles:"

#: lib/pepe/webhooks.ex:681
#, elixir-autogen, elixir-format
msgid "Change %{name} for this conversation only, or for everyone? Reply /model %{name} session or /model %{name} global."
msgstr ""
"¿Cambiar a %{name} solo en esta conversación o para todos? Responde /model "
"%{name} session o /model %{name} global."

#: lib/pepe/webhooks.ex:354
#, elixir-autogen, elixir-format
msgid "Current model: %{model}"
msgstr "Modelo actual: %{model}"

#: lib/pepe/webhooks.ex:645
#, elixir-autogen, elixir-format
msgid "Mention requirement is currently: off (I reply without being mentioned).\nUse /mention on or /mention off."
msgstr ""
"Exigir mención: desactivado (respondo sin que me mencionen).\n"
"Usa /mention on o /mention off."

#: lib/pepe/webhooks.ex:655
#, elixir-autogen, elixir-format
msgid "Mention requirement is currently: on (I need an @mention).\nUse /mention on or /mention off."
msgstr ""
"Exigir mención: activado (necesito una @mención).\n"
"Usa /mention on o /mention off."

#: lib/pepe/webhooks.ex:692
#, elixir-autogen, elixir-format
msgid "Model set to %{name} (%{scope})."
msgstr "Modelo cambiado a %{name} (%{scope})."

#: lib/pepe/webhooks.ex:694
#, elixir-autogen, elixir-format
msgid "No agent to set the model on."
msgstr "No hay agente sobre el que fijar el modelo."

#: lib/pepe/webhooks.ex:657
#, elixir-autogen, elixir-format
msgid "No models are configured for this project."
msgstr "Este proyecto no tiene modelos configurados."

#: lib/pepe/webhooks.ex:636
#, elixir-autogen, elixir-format
msgid "Noted, but this connection already answers every message here without needing a mention (require_mention is off on the connection) - this channel keeps replying without one regardless."
msgstr ""
"Anotado, pero esta conexión ya responde a todos los mensajes sin mención "
"(require_mention está desactivado en la conexión), así que este canal "
"seguirá respondiendo sin ella."

#: lib/pepe/webhooks.ex:648
#, elixir-autogen, elixir-format
msgid "This channel's own setting asks for a mention, but the connection itself already answers every message without one (require_mention is off) - so nothing here actually needs a mention right now."
msgstr ""
"El ajuste de este canal pide mención, pero la conexión ya responde a todo "
"sin ella (require_mention está desactivado). Ahora mismo aquí no hace falta "
"mencionar."

#: lib/pepe/webhooks.ex:663
#, elixir-autogen, elixir-format
msgid "Unknown model: %{name}"
msgstr "Modelo desconocido: %{name}"

#: lib/pepe/webhooks.ex:593
#, elixir-autogen, elixir-format
msgid "Usage: /mention on|off"
msgstr "Uso: /mention on|off"

#: lib/pepe/webhooks.ex:662
#, elixir-autogen, elixir-format
msgid "Usage: /model NAME [session|global]"
msgstr "Uso: /model NOMBRE [session|global]"

#: lib/pepe/webhooks.ex:672
#, elixir-autogen, elixir-format
msgid "You don't have permission to change the model here."
msgstr "No tienes permiso para cambiar el modelo aquí."

#: lib/pepe/webhooks.ex:629
#, elixir-autogen, elixir-format
msgid "👂 I'll reply here without being @mentioned, until /new."
msgstr "👂 Responderé aquí sin que me mencionen, hasta el próximo /new."

#: lib/pepe/webhooks.ex:642
#, elixir-autogen, elixir-format
msgid "📣 @mention required again in this chat."
msgstr "📣 Vuelve a hacer falta @mención en este chat."

#: lib/pepe/webhooks.ex:561
#, elixir-autogen, elixir-format
msgid "🧹 New conversation."
msgstr "🧹 Nueva conversación."

#: lib/pepe/webhooks.ex:451
#, elixir-autogen, elixir-format
msgid "This channel is bound to agent %{name}.\nUse /agent NAME to change it, or /agent none to clear."
msgstr ""
"Este canal está vinculado al agente %{name}.\n"
"Usa /agent NOMBRE para cambiarlo o /agent none para quitarlo."

#: lib/pepe/webhooks.ex:393
#, elixir-autogen, elixir-format
msgid "This channel is no longer bound to a specific agent - back to %{agent}."
msgstr "Este canal ya no tiene un agente fijo. Vuelve a %{agent}."

#: lib/pepe/webhooks.ex:436
#, elixir-autogen, elixir-format
msgid "This channel is now bound to agent %{name} (kept across /new and restarts)."
msgstr ""
"Este canal ahora está vinculado al agente %{name} (se mantiene con /new y al"
" reiniciar)."

#: lib/pepe/webhooks.ex:444
#, elixir-autogen, elixir-format
msgid "This channel isn't bound to a specific agent - it uses %{agent} (this connection's default).\nUse /agent NAME to bind it."
msgstr ""
"Este canal no tiene un agente fijo: usa %{agent} (el predeterminado de esta conexión).\n"
"Usa /agent NOMBRE para vincularlo."

#: lib/pepe/webhooks.ex:464
#, elixir-autogen, elixir-format
msgid "Unknown agent: %{name}"
msgstr "Agente desconocido: %{name}"

#: lib/pepe/webhooks.ex:386
#, elixir-autogen, elixir-format
msgid "You don't have permission to change this channel's agent."
msgstr "No tienes permiso para cambiar el agente de este canal."

#: lib/pepe/webhooks.ex:474
#, elixir-autogen, elixir-format
msgid "Agent switching is locked on this channel."
msgstr "En este canal no se puede cambiar de agente."

#: lib/pepe/webhooks.ex:462
#, elixir-autogen, elixir-format
msgid "This channel is bound to agent %{name}. Agent switching is locked here."
msgstr ""
"Este canal está vinculado al agente %{name}. Aquí no se puede cambiar de "
"agente."

#: lib/pepe/webhooks.ex:455
#, elixir-autogen, elixir-format
msgid "This channel isn't bound to a specific agent - it uses %{agent} (this connection's default). Agent switching is locked here."
msgstr ""
"Este canal no tiene un agente fijo: usa %{agent} (el predeterminado de esta "
"conexión). Aquí no se puede cambiar de agente."

#: lib/pepe/webhooks/discord.ex:88
#, elixir-autogen, elixir-format
msgid "Also answer normal messages, not only slash commands. Needs the bot token."
msgstr ""
"También responde mensajes normales, no solo comandos slash. Requiere el "
"token del bot."

#: lib/pepe/webhooks/msteams.ex:50
#, elixir-autogen, elixir-format
msgid "The Azure tenant ID (or botframework.com)"
msgstr "El ID del tenant de Azure (o botframework.com)"

#: lib/pepe/webhooks/msteams.ex:38
#, elixir-autogen, elixir-format
msgid "The bot's Microsoft app (client) ID"
msgstr "El ID de la app (cliente) de Microsoft del bot"

#: lib/pepe/webhooks/googlechat.ex:41
#, elixir-autogen, elixir-format
msgid "An OAuth access token for the Chat API. Write it as ${ENV_VAR}."
msgstr ""
"Un token de acceso OAuth para la API de Chat. Escríbelo como ${ENV_VAR}."

#: lib/pepe/webhooks/discord.ex:106
#: lib/pepe/webhooks/googlechat.ex:55
#: lib/pepe/webhooks/msteams.ex:54
#: lib/pepe/webhooks/slack.ex:62
#, elixir-autogen, elixir-format
msgid "Answer only when mentioned"
msgstr "Responder solo si lo mencionan"

#: lib/pepe/webhooks/whatsapp.ex:67
#, elixir-autogen, elixir-format
msgid "Any text you choose. Meta asks for it back when you connect the webhook."
msgstr ""
"Cualquier texto que elijas. Meta te lo pide de vuelta al conectar el "
"webhook."

#: lib/pepe/webhooks/discord.ex:121
#: lib/pepe/webhooks/whatsapp.ex:75
#, elixir-autogen, elixir-format
msgid "Biggest file it will accept, in MB (default: 20)."
msgstr "Archivo más grande que acepta, en MB (por defecto: 20)."

#: lib/pepe/webhooks/slack.ex:47
#, elixir-autogen, elixir-format
msgid "Find it on the app's Basic Information page. Write it as ${ENV_VAR}."
msgstr ""
"Lo encuentras en la página Basic Information de la app. Escríbelo como "
"${ENV_VAR}."

#: lib/pepe/webhooks/discord.ex:99
#, elixir-autogen, elixir-format
msgid "Find it on the app's Bot page. Needed to read channel messages."
msgstr ""
"Lo encuentras en la página Bot de la app. Hace falta para leer mensajes de "
"canales."

#: lib/pepe/webhooks/slack.ex:65
#, elixir-autogen, elixir-format
msgid "In channels, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"En los canales, responder solo cuando alguien @menciona al bot (por defecto:"
" sí)."

#: lib/pepe/webhooks/googlechat.ex:59
#, elixir-autogen, elixir-format
msgid "In group spaces, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"En los espacios de grupo, responder solo cuando alguien @menciona al bot "
"(por defecto: sí)."

#: lib/pepe/webhooks/discord.ex:110
#, elixir-autogen, elixir-format
msgid "In server channels, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"En los canales del servidor, responder solo cuando alguien @menciona al bot "
"(por defecto: sí)."

#: lib/pepe/webhooks/msteams.ex:58
#, elixir-autogen, elixir-format
msgid "In team channels, reply only when someone @mentions the bot (default: yes)."
msgstr ""
"En los canales del equipo, responder solo cuando alguien @menciona al bot "
"(por defecto: sí)."

#: lib/pepe/webhooks/whatsapp.ex:55
#, elixir-autogen, elixir-format
msgid "Meta's access token for sending messages. Write it as ${ENV_VAR}."
msgstr ""
"El token de acceso de Meta para enviar mensajes. Escríbelo como ${ENV_VAR}."

#: lib/pepe/webhooks/discord.ex:82
#, elixir-autogen, elixir-format
msgid "Read channel messages"
msgstr "Leer mensajes de canales"

#: lib/pepe/webhooks/slack.ex:41
#, elixir-autogen, elixir-format
msgid "Starts with xoxb-. Write it as ${ENV_VAR}."
msgstr "Empieza con xoxb-. Escríbelo como ${ENV_VAR}."

#: lib/pepe/webhooks/googlechat.ex:48
#, elixir-autogen, elixir-format
msgid "The Google Cloud project number. In the app's settings, set Authentication Audience to \"Project Number\"."
msgstr ""
"El número de proyecto de Google Cloud. En los ajustes de la app, pon "
"Authentication Audience en \"Project Number\"."

#: lib/pepe/webhooks/whatsapp.ex:49
#, elixir-autogen, elixir-format
msgid "The ID Meta gives your WhatsApp number for sending messages"
msgstr "El ID que Meta da a tu número de WhatsApp para enviar mensajes"

#: lib/pepe/webhooks/discord.ex:72
#, elixir-autogen, elixir-format
msgid "The app's Public Key (hex). Used to confirm messages really come from Discord."
msgstr ""
"La Public Key de la app (hex). Sirve para confirmar que los mensajes vienen "
"de Discord."

#: lib/pepe/webhooks/msteams.ex:44
#, elixir-autogen, elixir-format
msgid "The client secret. Write it as ${ENV_VAR}."
msgstr "El client secret. Escríbelo como ${ENV_VAR}."

#: lib/pepe/webhooks/whatsapp.ex:61
#, elixir-autogen, elixir-format
msgid "Used to confirm messages really come from Meta (X-Hub-Signature-256). Write it as ${ENV_VAR}."
msgstr ""
"Sirve para confirmar que los mensajes vienen de Meta (X-Hub-Signature-256). "
"Escríbelo como ${ENV_VAR}."

#: lib/pepe/webhooks/discord.ex:78
#, elixir-autogen, elixir-format
msgid "Used to send the reply"
msgstr "Se usa para enviar la respuesta"

#: lib/pepe/webhooks.ex:468
#, elixir-autogen, elixir-format
msgid "You don't have permission to change whether this channel needs an @mention. Ask one of this channel's trainers."
msgstr "No tienes permiso para cambiar si este canal necesita una @mención. Pídeselo a uno de los trainers del canal."

#: lib/pepe/webhooks/slack.ex:55
#, elixir-autogen, elixir-format
msgid "A 👍 or ❤️ on one of the bot's own messages is told to the agent as feedback (default: own; off to ignore reactions)."
msgstr "Un 👍 o ❤️ en un mensaje del propio bot le llega al agente como feedback (por defecto: own; off para ignorar las reacciones)."

#: lib/pepe/webhooks/slack.ex:51
#, elixir-autogen, elixir-format
msgid "Learn from reactions"
msgstr "Aprender de las reacciones"
