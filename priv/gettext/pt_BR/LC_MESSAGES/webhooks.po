msgid "This channel requires an @mention, set for this channel and kept after /new.\nUse /mention off always to open it up again."
msgstr "Este canal exige @menção, definido para este canal e mantido depois do /new.\nUse /mention off always para abrir de novo."

#: lib/pepe/webhooks.ex:968
#, elixir-autogen, elixir-format
msgid "a mention is required, the default"
msgstr "menção obrigatória, o padrão"

#: lib/pepe/webhooks.ex:967
#, elixir-autogen, elixir-format
