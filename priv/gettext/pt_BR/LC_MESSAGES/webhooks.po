#: lib/pepe/webhooks/slack.ex:49
#, elixir-autogen, elixir-format
msgid "in a channel, reply only when the bot is @mentioned (default true); a direct message always replies"
msgstr "em canal, só responde quando o bot é @mencionado (padrão: true); mensagem direta sempre é respondida"

#: lib/pepe/webhooks/googlechat.ex:59
#, elixir-autogen, elixir-format
msgid "in a multi-person space, reply only when the app is @mentioned (default true); a direct message always replies"
msgstr "em space com várias pessoas, só responde quando o app é @mencionado (padrão: true); mensagem direta sempre é respondida"

#: lib/pepe/webhooks/msteams.ex:58
#, elixir-autogen, elixir-format
msgid "in a team channel or group chat, reply only when the bot is @mentioned (default true); a 1:1 chat always replies"
msgstr "em canal de time ou conversa em grupo, só responde quando o bot é @mencionado (padrão: true); conversa 1:1 sempre é respondida"

#: lib/pepe/webhooks/msteams.ex:50
#, elixir-autogen, elixir-format
